# mira-panel's own secret store. Copy to `.env` (repo root) and fill the
# values from whatever local key machinery you use — the panel reads this
# file at runtime (secrets.ts); it is git-ignored and MUST never be committed.
# Environment variables with the same names take precedence over this file.

# Proxy for the Tavily request (bare host:port is fine); the TAVILY_PROXY
# env var outranks these when set
HTTPS_PROXY=
ALL_PROXY=

# 4-digit unlock PIN for the kiosk (locking is refused until it exists)
PANEL_PIN=

# Upstream API keys (Vikunja uses a Bearer token; the GLM pair is optional —
# without it the panel falls back to the nix-generated claude wrapper chain)
# Vikunja instance base URL (…/api/v1) — no built-in default; the vikunja
# source reports its own honest error until this is set
VIKUNJA_API=
VIKUNJA_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
GLM_API_KEY=
GLM_BASE_URL=
